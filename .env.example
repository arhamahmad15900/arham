# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OPENROUTER_API_KEY: Required for OpenRouter AI test generation.
# Configure your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

# OPENROUTER_MODEL: The model identifier to use on OpenRouter.
# e.g., "google/gemini-2.0-flash-001", "meta-llama/llama-3.3-70b-instruct", "deepseek/deepseek-chat"
OPENROUTER_MODEL="google/gemini-2.0-flash-001"

# PORT: Server port (defaults to 3000, Render sets this automatically)
PORT=3000

# NODE_ENV: Set to 'production' on Render
NODE_ENV=production

# ==============================================================================
# BUG REPORT EMAIL DELIVERY CONFIGURATION (REQUIRED ON RENDER FOR INBOX DELIVERY)
# ==============================================================================

# BUG_REPORT_RECIPIENT_EMAIL: The inbox that will receive all bug reports.
# Defaults to arhamahmad15900@gmail.com if not specified.
BUG_REPORT_RECIPIENT_EMAIL=arhamahmad15900@gmail.com

# OPTION 1: GMAIL APP PASSWORD (RECOMMENDED FOR GMAIL USERS)
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate an App Password: https://myaccount.google.com/apppasswords
# 3. Enter your Gmail and the 16-character generated password below:
SMTP_USER=your-email@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
SMTP_SERVICE=gmail

# OPTION 2: RESEND (TRANSACTIONAL EMAIL SERVICE)
# 1. Sign up at https://resend.com and create an API Key.
# 2. Add RESEND_API_KEY to Render:
# RESEND_API_KEY=re_123456789

# OPTION 3: CUSTOM SMTP (Brevo, SendGrid, Mailgun, Amazon SES, or Hostinger)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password
# SMTP_FROM="Access CBT Bug Tracker" <notifications@yourdomain.com>
